    "build:bin": "bun build src/index.ts --compile --outfile bin/whatsapp-agent-bridge"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
