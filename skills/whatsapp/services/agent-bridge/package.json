{
  "name": "whatsapp-agent-bridge",
  "version": "1.0.0",
  "description": "WhatsApp webhook bridge for AI agent auto-reply and draft review",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run dist/index.js",
